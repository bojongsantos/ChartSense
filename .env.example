# Optional local-only demo controls. Never enable these as production auth.
# PostgreSQL (use a pooled URL on Vercel).
DATABASE_URL=postgresql://chartsense:chartsense_dev@localhost:54329/chartsense

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false

# Transactional email (verification and password reset).
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=ChartSense <noreply@example.com>

# Midtrans Snap. Keep server key private; expose only the client key.
PAYMENT_PROVIDER=midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
PREMIUM_PRICE_IDR=99000

# Optional local/demo seed credentials. Never reuse these in production.
SEED_USER_PASSWORD=ChartSense123!
SEED_ADMIN_PASSWORD=ChartSense123!
